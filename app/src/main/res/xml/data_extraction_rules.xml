<?xml version="1.0" encoding="utf-8"?>
<!-- The only stored data is two settings (speech speed, auto-speak). Backing them up is
     harmless and saves a parent re-choosing them on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
